--- /mnt/data/origveil/Veil-mc1.21.1-4.5.0-fabric/common/src/main/java/foundry/veil/mixin/screenshake/client/ScreenShakeGameRendererMixin.java	2026-09-08 04:48:06.000000000 +0000
